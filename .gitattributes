# Normalize line endings in the repo; check out as-is per platform
* text=auto

# Binary files (never diff/merge as text)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.onnx binary
*.bin binary
*.task binary

# Model registry files are verified byte-for-byte against SHA-256 hashes in
# assets/models/registry.json. Line-ending conversion on checkout would change
# their bytes and fail the project's own health check, so nothing under
# assets/models/ is ever text-converted.
assets/models/** -text
